<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="start|center_vertical"
        android:text="FrameLayout 실습"
        android:textColor="#8BC34A"
        android:textSize="24sp"
        android:textStyle="bold|italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2">

                <ImageView
                    android:id="@+id/imgBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:scaleType="fitStart"
                    android:contentDescription="캐릭터"
                    app:srcCompat="@drawable/body" />

                <ImageView
                    android:id="@+id/imgCrown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:scaleType="fitStart"
                    android:contentDescription="착용한 왕관"
                    app:srcCompat="@drawable/crown1" />

                <ImageView
                    android:id="@+id/imgDress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="160dp"
                    android:scaleType="fitStart"
                    android:contentDescription="착용한 드레스"
                    app:srcCompat="@drawable/dress1" />

                <ImageView
                    android:id="@+id/imgNeck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="160dp"
                    android:scaleType="fitStart"
                    android:contentDescription="착용한 목걸이"
                    app:srcCompat="@drawable/necklace2" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgCrown1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClickChoice"
                        android:scaleType="fitCenter"
                        android:contentDescription="왕관 1 선택"
                        app:srcCompat="@drawable/crown1" />

                    <ImageView
                        android:id="@+id/imgCrown2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClickChoice"
                        android:scaleType="fitCenter"
                        android:contentDescription="왕관 2 선택"
                        app:srcCompat="@drawable/crown2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgNeck1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClickChoice"
                        android:scaleType="fitCenter"
                        android:contentDescription="목걸이 1 선택"
                        app:srcCompat="@drawable/necklace1" />

                    <ImageView
                        android:id="@+id/imgNeck2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClickChoice"
                        android:scaleType="fitCenter"
                        android:contentDescription="목걸이 2 선택"
                        app:srcCompat="@drawable/necklace2" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgDress1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:scaleType="fitCenter"
                android:contentDescription="드레스 1 선택"
                app:srcCompat="@drawable/dress1" />

            <ImageView
                android:id="@+id/imgDress2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:scaleType="fitCenter"
                android:contentDescription="드레스 2 선택"
                app:srcCompat="@drawable/dress2" />

            <ImageView
                android:id="@+id/imgDress3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:scaleType="fitCenter"
                android:contentDescription="드레스 3 선택"
                app:srcCompat="@drawable/dress3" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#00BCD4"
        android:onClick="onClickReset"
        android:text="다시하기"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>